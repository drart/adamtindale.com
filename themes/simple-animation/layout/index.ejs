<%# Blog Index Page - displays paginated list of posts %>

<% page.posts.forEach(function(post) { %>
    <h1 class="title">
        <a href="<%- url_for(post.path) %>"><%- post.title %></a>
    </h1>
    <div class="published">
        <%- date(post.date, 'dddd MMMM DD, YYYY') %><br />
        Category: <a href="<%- url_for(post.categories.data[0].path) %>"><%- post.categories.data[0].name %></a>
    </div>
    <div class="entry-content"><%- post.content %></div>
<% }); %>

<hr style="margin:30px">

<%# Pagination %>
<% if (page.total > 1) { %>
<p class="paginator">
    <% if (page.prev) { %>
        <% if (page.prev === 1) { %>
        <a href="<%- url_for(config.archive_dir || 'blog') %>/">&larr;&nbsp;&nbsp;&nbsp;newer</a>
        <% } else { %>
        <a href="<%- url_for((config.archive_dir || 'blog') + '/page/' + page.prev + '/') %>">&larr;&nbsp;&nbsp;&nbsp;newer</a>
        <% } %>
        ::
    <% } %>
    <% if (page.next) { %>
    <a href="<%- url_for((config.archive_dir || 'blog') + '/page/' + page.next + '/') %>">older&nbsp;&nbsp;&nbsp;&rarr;</a>
    <% } %>
</p>
<% } %>